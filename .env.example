NEXORA_HOST=0.0.0.0
NEXORA_PORT=8787
NEXORA_DB=./database/nexora.sqlite
NEXORA_SESSION_HOURS=24

# Gemini API — keep the key server-side only.
# Free-tier access is subject to Google's current project/model quotas.
NEXORA_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
NEXORA_MODEL_NAME=gemini-3.7-flash
NEXORA_MODEL_FALLBACK=gemini-3.1-flash-lite

# Optional keyless Nexora model service instead of direct Gemini:
# NEXORA_MODEL_PROVIDER=nexora
# NEXORA_MODEL_URL=https://nexora-api-model.rakibulhasan1301.workers.dev/v1
# NEXORA_MODEL_NAME=nexora-coder
# NEXORA_MODEL_API_KEY=

NEXORA_WORKSPACE=./workspace
NEXORA_ALLOW_NETWORK=false
NEXORA_AGENT_MAX_STEPS=60
