NEXORA_HOST=0.0.0.0
NEXORA_PORT=8787
NEXORA_DB=./database/nexora.sqlite
NEXORA_SESSION_HOURS=24

# Google Gemini API — keep the key server-side only.
NEXORA_MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_NAME=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

NEXORA_WORKSPACE=./workspace
NEXORA_ALLOW_NETWORK=false
NEXORA_AGENT_MAX_STEPS=60
